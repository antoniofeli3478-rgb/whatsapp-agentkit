# Agente de locação — variáveis de ambiente
# Copie para .env e preencha:   cp .env.example .env
# NUNCA suba o .env para o GitHub.

# ── Empresa ────────────────────────────────────────────────
# Nome da pasta em empresas/ (ex.: anima-kids)
EMPRESA=anima-kids

# ── Anthropic ──────────────────────────────────────────────
# Pegue em https://platform.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo do Claude. Padrão do AgentKit: claude-sonnet-5
#   claude-opus-5-5    o mais capaz      $4 / $20 por milhão de tokens
#   claude-sonnet-5-5  o Sonnet atual    $2 / $10
#   claude-sonnet-5    padrão do molde   $2 / $10
#   claude-haiku-5-5   o mais barato     $0,10 / $0,50
ANTHROPIC_MODEL=claude-sonnet-5
# Esforço de raciocínio: low | medium | high. Vazio = não manda o parâmetro.
ANTHROPIC_EFFORT=low
# Opcional, padrão 4096. O raciocínio interno também conta contra este teto.
# ANTHROPIC_MAX_TOKENS=4096

# ── Equipe ─────────────────────────────────────────────────
# Números que recebem a ficha e podem mandar "#bot voltar <telefone>" (com DDI, vírgula entre eles)
EQUIPE_WHATSAPP=
# Horas que o agente fica quieto depois que a equipe assume um cliente
PAUSA_HORAS=12
# Senha do painel /painel?token=... (vazio = painel desligado). Invente uma senha longa.
PAINEL_TOKEN=

# ── Provedor de WhatsApp: zernio | meta ────────────────────
WHATSAPP_PROVIDER=zernio

# ── Zernio (se WHATSAPP_PROVIDER=zernio) ───────────────────
ZERNIO_API_KEY=
# Você inventa: serve para conferir que o webhook veio mesmo da Zernio
ZERNIO_WEBHOOK_SECRET=
# Opcional: só para o teste de conexão ao subir
ZERNIO_ACCOUNT_ID=
# ZERNIO_BASE_URL=

# ── Meta Cloud API (se WHATSAPP_PROVIDER=meta) ─────────────
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify
# META_APP_SECRET=
# META_API_VERSION=v25.0

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Banco de dados ─────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produção (Railway): DATABASE_URL=${{Postgres.DATABASE_URL}}
